# Server-only. Never prefix these with NEXT_PUBLIC_ — the browser must not see them.

# Base URL of the CRM backend (no trailing slash, no /api).
# Local: http://localhost:5000   Production: https://your-backend.onrender.com
CRM_API_URL=http://localhost:5000

# Must equal PUBLIC_API_KEY in the backend .env. Lets the API trust the visitor
# IP this server forwards (per-visitor rate limiting) and skip read throttling.
PUBLIC_API_KEY=
